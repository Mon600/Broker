# Docker:  cp .env.example .env && docker compose up --build
# Значения — только для локальной разработки.

# ---------- PostgreSQL ----------
POSTGRES_DB=store
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
# Порт БД на хосте (контейнер слушает 5432; проброс только на 127.0.0.1)
POSTGRES_PORT=5432
# JDBC URL используется только при запуске приложений ВНЕ Docker;
# в compose URL собирается сам: jdbc:postgresql://postgres:5432/${POSTGRES_DB}
DB_URL=jdbc:postgresql://localhost:5432/store

# ---------- store ----------
# Порт приложения: и внутри контейнера, и на хосте
SERVER_PORT=8080
# Порт на хосте (по умолчанию = 8080)
STORE_PORT=8080

# ---------- Redis (кэш изображений товаров) ----------
REDIS_PORT=6379

# ---------- Kafka ----------
# Адрес брокера для контейнеров (INTERNAL-листенер).
# Для запуска приложений вне Docker: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# Интервал генерации событий worker'ом, мс
WORKER_EVENT_INTERVAL_MS=3000
# Порт Kafka UI на хосте
KAFKA_UI_PORT=8081

# ---------- JVM (store и worker в контейнерах) ----------
# Для удалённой отладки добавьте:
#   -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
